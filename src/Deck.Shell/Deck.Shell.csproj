<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The 10.0.19041 flavour brings in the Windows SDK projections, which is the only way to
         read what's currently playing (Windows.Media.Control). Otherwise identical to
         net10.0-windows. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon only: balloon tips surface as real Windows notifications from an
         unpackaged app without needing a registered AUMID and Start Menu shortcut. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\deck.ico</ApplicationIcon>

    <AssemblyName>Deck</AssemblyName>
    <Product>Deck</Product>
    <AssemblyTitle>Deck</AssemblyTitle>
    <Company>Baris Ozpercin</Company>
    <Version>1.0.0</Version>
    <Copyright>© 2026</Copyright>

    <!-- Self-contained is passed on the publish command rather than set here, so ordinary
         debug builds keep their plain output path. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- WFO0003 tells WinForms apps to set DPI mode in code instead of the manifest. This is a
         WPF app that references WinForms solely for NotifyIcon; the manifest's PerMonitorV2 is
         what keeps window positioning correct across this desktop's monitors, so it stays. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms adds these as global usings, which then collide with WPF's
         Application, MessageBox, Point, Color and friends in every file. Only Notifier.cs
         wants WinForms and it uses an explicit alias. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- ui\dev is a browser harness for working on the page; the app never loads it. -->
    <Content Include="ui\**\*" Exclude="ui\dev\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The layout rules and migration are internal; the tests need to reach them. -->
    <InternalsVisibleTo Include="Deck.Shell.Tests" />
  </ItemGroup>

</Project>
